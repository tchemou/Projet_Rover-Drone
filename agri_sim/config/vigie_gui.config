<?xml version="1.0"?>
<!-- Interface Gazebo du projet Vigie Betterave : sobre, aux couleurs de la console, centrée sur la scène.
     Lancée avec : gz sim -g --gui-config vigie_gui.config -->

<dialog name="quick_start" show_again="false"/>

<window>
  <width>1500</width>
  <height>880</height>
  <style
    material_theme="Dark"
    material_primary="Pink"
    material_accent="Pink"
    toolbar_color_light="#f3f3f3"
    toolbar_text_color_light="#111111"
    toolbar_color_dark="#0d1612"
    toolbar_text_color_dark="#e8f0eb"
    plugin_toolbar_color_light="#bbdefb"
    plugin_toolbar_text_color_light="#111111"
    plugin_toolbar_color_dark="#1b2a22"
    plugin_toolbar_text_color_dark="#e8f0eb"
  />
  <menus>
    <drawer default="false">
    </drawer>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<!-- Scène 3D : vue de départ en plongée sur la parcelle, depuis le sud-est -->
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.5 0.5 0.52</ambient_light>
  <background_color>0.55 0.72 0.9</background_color>
  <camera_pose>6 -10.5 8.5 0 0.61 2.09</camera_pose>
</plugin>

<plugin filename="EntityContextMenuPlugin" name="Entity context menu">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Nécessaire aux étiquettes et marqueurs 3D (anneaux de détection, jets, textes) -->
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="SelectEntities" name="Select Entities">
  <gz-gui>
    <anchors target="Select entities">
      <line own="right" target="right"/>
      <line own="top" target="top"/>
    </anchors>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Lecture / pause de la simulation (en bas à gauche) -->
<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>World control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">72</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>
  <play_pause>true</play_pause>
  <step>false</step>
  <start_paused>false</start_paused>
  <use_event>true</use_event>
</plugin>

<!-- Temps simulé et facteur temps réel (en bas à droite) -->
<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <title>World stats</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">80</property>
    <property type="double" key="width">300</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>
  <sim_time>true</sim_time>
  <real_time>false</real_time>
  <real_time_factor>true</real_time_factor>
  <iterations>false</iterations>
</plugin>

<!-- Caméras embarquées incrustées (en haut à droite) -->
<plugin filename="ImageDisplay" name="Camera rover">
  <gz-gui>
    <title>Rover R1 · caméra avant</title>
    <property key="state" type="string">floating</property>
    <property type="double" key="width">360</property>
    <property type="double" key="height">255</property>
    <property type="double" key="z">2</property>
    <property key="showTitleBar" type="bool">true</property>
    <property type="double" key="x">1116</property>
    <property type="double" key="y">14</property>
  </gz-gui>
  <topic>camera/image_raw</topic>
  <topic_picker>false</topic_picker>
</plugin>

<plugin filename="ImageDisplay" name="Camera drone">
  <gz-gui>
    <title>Drone D1 · caméra nadir</title>
    <property key="state" type="string">floating</property>
    <property type="double" key="width">360</property>
    <property type="double" key="height">285</property>
    <property type="double" key="z">2</property>
    <property key="showTitleBar" type="bool">true</property>
    <property type="double" key="x">1116</property>
    <property type="double" key="y">283</property>
  </gz-gui>
  <topic>drone/camera/image_raw</topic>
  <topic_picker>false</topic_picker>
</plugin>

<!-- Capture d'écran (discrète, en haut à gauche) -->
<plugin filename="Screenshot" name="Screenshot">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="x" type="double">14</property>
    <property key="y" type="double">14</property>
    <property key="width" type="double">50</property>
    <property key="height" type="double">50</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#1b2a22</property>
  </gz-gui>
</plugin>
